#!/usr/bin/env bash

#
# Prints Formula/kosh.rb for one Koshka release. The first argument is the
# release tag, and the second is the path of that release's SHA256SUMS file.
#
set -euo pipefail
if [ "$#" -ne 2 ]
then
  echo "usage: render-formula <version> <SHA256SUMS>" >&2
  exit 2
fi

VERSION=$1
SUMS=$2
BASE="https://github.com/fennec-support/kosh/releases/download/$VERSION"

checksum_of ()
{
  local ASSET=$1
  local SUM
  SUM=$(awk -v name="$ASSET" '$2 == name { print $1 }' "$SUMS")

  if [ -z "$SUM" ]
  then
    echo "render-formula: $ASSET is missing from $SUMS" >&2
    exit 1
  fi

  printf '%s' "$SUM"
}

DARWIN_ARM64="kosh-darwin-aarch64-$VERSION"
LINUX_ARM64="kosh-linux-aarch64-$VERSION"
LINUX_AMD64="kosh-linux-amd64-$VERSION"
DARWIN_ARM64_SUM=$(checksum_of "$DARWIN_ARM64")
LINUX_ARM64_SUM=$(checksum_of "$LINUX_ARM64")
LINUX_AMD64_SUM=$(checksum_of "$LINUX_AMD64")

cat <<EOF
class Kosh < Formula
  desc "Fast shell with static analysis and a language server"
  homepage "https://github.com/fennec-support/kosh"
  license "BSD-3-Clause"

  on_macos do
    depends_on arch: :arm64

    on_arm do
      url "$BASE/$DARWIN_ARM64"
      sha256 "$DARWIN_ARM64_SUM"
    end
  end

  on_linux do
    on_arm do
      url "$BASE/$LINUX_ARM64"
      sha256 "$LINUX_ARM64_SUM"
    end

    on_intel do
      url "$BASE/$LINUX_AMD64"
      sha256 "$LINUX_AMD64_SUM"
    end
  end

  def install
    asset = if OS.mac?
      "kosh-darwin-aarch64-#{version}"
    elsif Hardware::CPU.arm?
      "kosh-linux-aarch64-#{version}"
    else
      "kosh-linux-amd64-#{version}"
    end

    bin.install asset => "kosh"
  end

  test do
    assert_equal "hello", shell_output("#{bin}/kosh -c 'echo hello'").strip
  end
end
EOF
